#. +> trunk5
#: ../../user_manual/indi.rst:5
#, fuzzy
#| msgid "&kstars; provides an interface to configure and control astronomical instruments via the <acronym><link linkend=\"what-is-indi\">INDI</link></acronym> protocol."
msgid "KStars provides an interface to configure and control astronomical instruments via the :ref:`INDI <indi-faq-what-is-indi>` protocol."
msgstr "&kstars; fournit une interface pour configurer et piloter les instruments astronomiques par le protocole <acronym><link linkend=\"what-is-indi\">INDI</link></acronym>."

#. +> trunk5
#: ../../user_manual/indi.rst:9
#, fuzzy
#| msgid "The <acronym>INDI</acronym> protocol supports a variety of astronomical instruments such as CCD cameras and focusers. For an up to date list of supported devices, please visit <acronym>INDI</acronym> <ulink url=\"https://indilib.org/index.php?title=Devices\">supported devices page</ulink>."
msgid "The INDI protocol supports a variety of astronomical instruments such as CCD cameras and focusers. For an up to date list of supported devices, please visit INDI `supported devices page <https://indilib.org/index.php?title=Devices>`__."
msgstr "Le protocole <acronym>INDI</acronym> gère une grande variété d'instruments astronomiques, comme les caméra CCD et les viseurs. Pour une liste à jour des matériels pris en charge, veuillez consulter la page <acronym>INDI</acronym> <ulink url=\"https://indilib.org/index.php?title=Devices\"> des matériels gérés</ulink>."
